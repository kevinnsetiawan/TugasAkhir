\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tus-style}[2025/10/09 v1.0 Template Proposal TA TUS]

\RequirePackage{titlesec}
\RequirePackage[a4paper, left=40mm, right=30mm, top=30mm, bottom=30mm]{geometry}
\RequirePackage[bahasai]{babel}
\RequirePackage[natbibapa]{apacite}
\RequirePackage{xurl}
\RequirePackage[table,xcdraw]{xcolor}
\RequirePackage{caption}
\RequirePackage{graphicx} % Required for inserting images
\RequirePackage{amsmath}
\RequirePackage[T1]{fontenc}
\RequirePackage{newtx} % font Times New Roman
\RequirePackage{algorithm}
\RequirePackage{multirow}
\RequirePackage{lipsum}
\RequirePackage{silence}
\RequirePackage{array}
\RequirePackage{calc}
\RequirePackage{tabularx}
\RequirePackage{ragged2e}

\usepackage{setspace}

\onehalfspacing

\DeclareCaptionLabelFormat{alglabel}{Algoritma #2:} % #2 is the chapter/algorithm number
\captionsetup[algorithm]{labelformat=alglabel,labelfont=normalfont} 
% labelfont=bf is optional, makes the label bold

% Define the custom column type for ragged-right (left-aligned) wrapping text
\newcolumntype{L}{>{\RaggedRight\arraybackslash}X}

% APA style bibliography
\def\BBAB{dan} % replace 'and' with 'dan'

%\renewcommand{\BEd}{Editor}     % "Editor" (singular)
\WarningFilter{apacite}{No suitable language definition file}

% --- Change Bibliography Title ---
\renewcommand{\refname}{Daftar Pustaka}
\renewcommand{\bibname}{Daftar Pustaka}
% --- End Custom Redefinitions ---

% Chapter spacing: left indent, before-skip, after-skip
\titlespacing*{\chapter}{0pt}{-10pt}{20pt}

% Chapter title → 14pt, bold, centered, ALL CAPS
\titleformat{\chapter}
  [display]
  {\normalfont\bfseries\centering\fontsize{14pt}{16pt}\selectfont}
  {\MakeUppercase{\chaptertitlename~\thechapter}}{0.5em}
  {\MakeUppercase}
  [\vspace{-2ex}]  % ← reduce spacing *after* the chapter title

% Section → 12pt, bold, left-aligned
\titleformat{\section}
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont}
  {\thesection}{1em}{}

\titleformat{\subsection}
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont}
  {\thesubsection}{1em}{}

\titleformat{\subsubsection}
  {\normalfont\bfseries\fontsize{12pt}{14pt}\selectfont}
  {\thesubsubsection}{1em}{}

